{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated learner profile and summary stats stored per user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "description": "Learner display name."
        },
        "totalStars": {
          "type": "integer",
          "description": "Total stars earned across 20 lessons (0-60)."
        },
        "completedLessonsCount": {
          "type": "integer",
          "description": "Count of completed lessons (0-20)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": ["userId", "displayName", "totalStars", "completedLessonsCount", "createdAt", "updatedAt"]
    },
    "CloudLessonProgress": {
      "title": "CloudLessonProgress",
      "description": "Per-lesson completion, stars, and quiz score synced to cloud.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "lessonId": {
          "type": "integer",
          "description": "Lesson number (1-20)."
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the lesson was completed."
        },
        "stars": {
          "type": "integer",
          "description": "Stars earned (0-3)."
        },
        "bestScore": {
          "type": "integer",
          "description": "Best practice score."
        },
        "totalQuestions": {
          "type": "integer",
          "description": "Total questions in lesson practice."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["userId", "lessonId", "completed", "stars", "bestScore", "totalQuestions", "updatedAt"]
    },
    "DailyChatUsage": {
      "title": "DailyChatUsage",
      "description": "Daily Persian AI chat message count per user (capped at 10 per day).",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "dateKey": {
          "type": "string",
          "description": "UTC/local date string YYYY-MM-DD."
        },
        "messageCount": {
          "type": "integer",
          "description": "Number of chat messages sent on this date (0-10)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last message."
        }
      },
      "required": ["userId", "dateKey", "messageCount", "updatedAt"]
    },
    "ChatReport": {
      "title": "ChatReport",
      "description": "User report for inappropriate AI chat responses.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Reporter Firebase Auth UID."
        },
        "promptText": {
          "type": "string",
          "description": "User prompt associated with report."
        },
        "responseText": {
          "type": "string",
          "description": "Model response being reported."
        },
        "reason": {
          "type": "string",
          "description": "Short reason provided by user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of report submission."
        }
      },
      "required": ["userId", "promptText", "responseText", "reason", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Per-user profile and aggregate progress."
    },
    "/users/{userId}/lesson_progress/{lessonDocId}": {
      "schema": { "$ref": "#/entities/CloudLessonProgress" },
      "description": "Per-user synced lesson progress documents."
    },
    "/users/{userId}/daily_usage/{dateKey}": {
      "schema": { "$ref": "#/entities/DailyChatUsage" },
      "description": "Per-user daily chat quota tracking."
    },
    "/users/{userId}/chat_reports/{reportId}": {
      "schema": { "$ref": "#/entities/ChatReport" },
      "description": "Per-user inappropriate AI response reports."
    }
  }
}
